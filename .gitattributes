# LF everywhere, also on Windows checkouts: shell scripts, YAML, fixtures and
# snapshots must stay byte-identical.
* text=auto eol=lf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zst binary
*.gz binary
*.zip binary
*.sqlite binary

# Recorded source data and snapshots are kept byte for byte.
fixtures/** -text
*.snap linguist-generated=true

# Generated files: collapsed in diffs on GitHub and left out of language stats.
# Regenerate them (`cargo xtask catalog build`), never edit them by hand.
crates/unpatched-catalog/src/catalog.generated.json linguist-generated=true -diff
Cargo.lock linguist-generated=true
.github/workflows/release.yml linguist-generated=true
