{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Amet13/unpatched",
  "title": "unpatched",
  "description": "Is the software you run affected by a vulnerability? Verdicts with evidence and fixed versions",
  "version": "3.0.1",
  "websiteUrl": "https://amet13.github.io/unpatched/",
  "repository": {
    "url": "https://github.com/Amet13/unpatched",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/amet13/unpatched:3.0.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--mount",
          "value": "type=bind,src={stack_dir},dst=/work",
          "description": "The folder with unpatched.yml, mounted where the server works",
          "isRequired": true,
          "variables": {
            "stack_dir": {
              "description": "The folder that holds unpatched.yml",
              "format": "filepath",
              "isRequired": true
            }
          }
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "command",
          "value": "mcp"
        }
      ]
    }
  ]
}
