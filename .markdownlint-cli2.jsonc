{
  // Prose is wrapped by hand or not at all; tables and URLs are long.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": { "allowed_elements": ["br", "details", "summary", "img", "picture", "source", "p", "a", "h1", "strong", "div", "span"] },
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD060": false
  },
  "ignores": ["node_modules", "target", "book", "CHANGELOG.md", "docs/guide/SUMMARY.md"]
}
